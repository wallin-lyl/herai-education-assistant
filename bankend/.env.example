# Domestic free provider. Keep this value unless you explicitly switch providers.
AI_PROVIDER=zhipu
ZHIPU_API_KEY=replace_with_your_free_zhipu_key
ZHIPU_MODEL=glm-4.7-flash
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Optional legacy Gemini configuration. It is not used while AI_PROVIDER=zhipu.
# GEMINI_API_KEY=replace_with_your_key
# GEMINI_MODEL=gemini-3.1-flash-lite
MAX_HISTORY_MESSAGES=24
MAX_OUTPUT_TOKENS=2048
CONNECT_TIMEOUT_SECONDS=20
IDLE_TIMEOUT_SECONDS=30
MAX_RETRIES=2
MAX_CONCURRENT_CHATS=1
RATE_LIMIT_PER_MINUTE=20
# Set true only when the API is behind a trusted reverse proxy or tunnel.
TRUST_PROXY_HEADERS=false
# Leave empty to allow local Flutter development origins only.
CORS_ORIGINS=
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?
